TRUECONF_URL_BASE=http://trueconf-server
TRUECONF_API_PREFIX=/api/v4
TRUECONF_OAUTH_TOKEN_PATH=/oauth2/v1/token

TRUECONF_CLIENT_ID=your_oauth_client_id
TRUECONF_CLIENT_SECRET=your_oauth_client_secret

TRUECONF_STATIC_TOKEN=

# Сетевые настройки для межконтейнерного взаимодействия
TRUECONF_VERIFY_SSL=false
TRUECONF_REQUEST_TIMEOUT=15.0
TRUECONF_MAX_RETRIES=3
TRUECONF_RETRY_BACKOFF=1.0
TRUECONF_TOKEN_REFRESH_MARGIN=60

# Настройки пуллинга (опроса завершённых звонков)
TRUECONF_POLL_INTERVAL_SECONDS=10.0
TRUECONF_POLL_PAGE_SIZE=50
TRUECONF_POLL_LOOKBACK_SECONDS=3600
TRUECONF_REQUIRE_RECORDING=false
TRUECONF_STATE_FILE=/tmp/trueconf_processed_calls.json